# Copy to .env and adjust. Nothing here is a real credential.

# --- hub -------------------------------------------------------------------
HUB_PORT=8080
# Operator account for the control endpoints (trigger sync, backfill, resolve drift).
SYNCHUB_ADMIN_USERNAME=admin
SYNCHUB_ADMIN_PASSWORD=change-me

# Datasource (prod/docker profile; the dev profile uses embedded H2 and ignores these)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/synchub
SPRING_DATASOURCE_USERNAME=synchub
SPRING_DATASOURCE_PASSWORD=synchub

# Kafka bootstrap servers for change events; SYNCHUB_EVENTS_TRANSPORT=log disables Kafka (dev)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SYNCHUB_EVENTS_TRANSPORT=kafka

# Scheduled incremental sync of every feed (fixed delay between passes)
SYNCHUB_SYNC_SCHEDULED=true
SYNCHUB_SYNC_INTERVAL=60s

# System A (source) connection
SYSTEM_A_BASE_URL=http://localhost:8081
SYSTEM_A_API_KEY=system-a-dev-key

# --- system-a-sim ------------------------------------------------------------
SYSTEM_A_PORT=8081

# --- docker compose host ports (change if something else already listens) ----
POSTGRES_PORT=5432
KAFKA_HOST_PORT=29092
DASHBOARD_PORT=5173
