<?xml version="1.0" encoding="UTF-8"?>
<!-- Structured-enough console logging: every line carries the run id and feed from the MDC when a sync is in progress. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%15.15t] %-40.40logger{39} run=%X{runId:--} feed=%X{feed:--} : %m%n%wEx</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
